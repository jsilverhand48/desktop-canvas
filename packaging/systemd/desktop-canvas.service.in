# systemd user service for desktop-canvas.
# Enable with: systemctl --user enable --now desktop-canvas
# The service binds to the graphical session so it starts after the
# compositor is up and stops on logout.
[Unit]
Description=desktop-canvas animated wallpaper daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=@CMAKE_INSTALL_PREFIX@/bin/desktop-canvas
Restart=on-failure
RestartSec=3
# Wallpapers on removable media may not be mounted yet at login; the daemon
# handles that, but give it a moment on very slow mounts.
TimeoutStartSec=15
# Safety net against memory leaks: if the daemon (plus its scene children)
# exceeds this, the kernel OOM kills inside this cgroup only and
# Restart=on-failure brings it back, instead of the system wide OOM killer
# taking out an unrelated application. Measured peaks at 2560x1440: the
# scene helper about 650 MiB on the largest scenes per output group, plus
# the daemon and a web helper.
MemoryMax=4G

[Install]
WantedBy=graphical-session.target
