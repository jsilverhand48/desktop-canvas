pkgbase = desktop-canvas
	pkgdesc = Animated Wallpaper Engine wallpapers behind your Linux desktop
	pkgver = 1.0.0
	pkgrel = 1
	url = https://github.com/jsilverhand48/desktop-canvas
	arch = x86_64
	license = MIT
	license = BSD-3-Clause
	makedepends = cmake
	makedepends = ninja
	makedepends = pkgconf
	makedepends = qt6-base
	makedepends = qt6-declarative
	makedepends = qt6-webengine
	makedepends = layer-shell-qt
	depends = wayland
	depends = libglvnd
	depends = mpv
	depends = libx11
	depends = libxrandr
	depends = libepoxy
	depends = libpng
	depends = lz4
	depends = libjpeg-turbo
	depends = freetype2
	depends = fontconfig
	depends = systemd-libs
	source = desktop-canvas-1.0.0.tar.gz::https://github.com/jsilverhand48/desktop-canvas/archive/refs/tags/v1.0.0.tar.gz
	sha256sums = SKIP

pkgname = desktop-canvas
	optdepends = linux-wallpaperengine: scene (scene.pkg) wallpaper support, from the AUR as linux-wallpaperengine-git
	optdepends = desktop-canvas-web: web (HTML/JS) wallpaper support
	optdepends = plasma-desktop: KDE integration, keeps desktop icons above the wallpaper

pkgname = desktop-canvas-web
	pkgdesc = Web (HTML/JS) wallpaper backend for desktop-canvas
	depends = desktop-canvas=1.0.0-1
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-webengine
	depends = layer-shell-qt
